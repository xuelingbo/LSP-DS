&share
 wrf_core             = 'ARW'
 max_dom              = 1
 start_date           = '2026-02-04_03:00:00'
 end_date             = '2026-02-04_18:00:00'
 interval_seconds     = 21600
 io_form_geogrid      = 2
 debug_level          = 0
/

&geogrid
 parent_id            = 1
 parent_grid_ratio    = 1
 i_parent_start       = 1
 j_parent_start       = 1
 e_we                 = 400
 e_sn                 = 400
 geog_data_res        = 'jaxa2modis_2014-2016_100m_epsg4326+bnu_soil_30s+default',
 dx                   = 500
 dy                   = 500
 map_proj             = 'lambert'
 ref_lat              = 35.791
 ref_lon              = 139.796
 truelat1             = 30
 truelat2             = 40
 stand_lon            = 139.796
 geog_data_path       = '/home/xuelingbo/Build_WRF/WPS_GEOG/'
/

&ungrib
 out_format           = 'WPS'
 prefix               = 'FILE'
/

&metgrid
 fg_name              = 'FILE'
 io_form_metgrid      = 2
 opt_metgrid_tbl_path = './metgrid'
/

